  "roles": [
    {
      "id": "R1",
      "name": "Lead Architect / Integrator",
      "responsibility": "Границы модулей, Battle lifecycle, Event/Command contracts, интеграция PR",
      "ownership": "src/core, src/battle, публичные интерфейсы",
      "boundary": "Не реализует контент башен/врагов и UI-детали"
    },
    {
      "id": "R2",
      "name": "Balance & Data Engineer",
      "responsibility": "JSON-схемы, конфиги, формулы баланса, difficulty, wave budgets, simulator inputs",
      "ownership": "configs, tools/config_validator, tests/balance",
      "boundary": "Не меняет runtime-логику без архитектурного RFC"
    },
    {
      "id": "R3",
      "name": "Combat Gameplay Engineer",
      "responsibility": "Tower/Enemy models, targeting, attacks, damage, statuses, economy, wave runtime",
      "ownership": "src/entities, src/systems/combat*",
      "boundary": "Не связывает доменную логику со Sprite/Control"
    },
    {
      "id": "R4",
      "name": "Performance / Runtime Engineer",
      "responsibility": "Pooling, spatial indexing, projectile/VFX runtime, performance budgets",
      "ownership": "src/pooling, performance helpers",
      "boundary": "Оптимизация только через измеряемые benchmark-сценарии"
    },
    {
      "id": "R5",
      "name": "Navigation / Level Systems Engineer",
      "responsibility": "Kingdom Rush fixed paths, PathProvider API, движение по пути, future maze seam",
      "ownership": "src/pathfinding, map path authoring",
      "boundary": "Grid/maze в MVP не реализуется, только интерфейс-заглушка"
    },
    {
      "id": "R6",
      "name": "UI/UX & Presentation Engineer",
      "responsibility": "HUD, pause/speed, tower menu, responsive layout, views, juice",
      "ownership": "src/ui, src/presentation, scenes/ui",
      "boundary": "UI общается с Battle только через Commands/Events"
    },
    {
      "id": "R7",
      "name": "QA / DevOps Engineer",
      "responsibility": "Тесты, CI, JSON validation, regression/performance gates, release checklist",
      "ownership": "tests, .github, tooling",
      "boundary": "Не правит игровую логику ради прохождения теста"
    },
    {
      "id": "R8",
      "name": "Level & Content Designer",
      "responsibility": "5 MVP-уровней, wave composition, tower/enemy roster, boss L5, минимальная прогрессия",
      "ownership": "configs/content, scenes/maps, docs/content",
      "boundary": "Баланс-цифры согласуются с R2; новые механики не добавляются без RFC"
    }
  ],
